      "decodedTransfer": "bt709",
      "expect": {
        "origin": { "colorSpace": "sdr_bt709", "original": null },
        "grade": false, "cutoutKey": null, "gradeKey": null,
        "proxy": { "input": "/proj/media/download.mp4", "tonemap": false }
