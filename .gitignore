# Root-anchored: only the repo's own scripts/ dir. An unanchored `scripts/`
# also swallows montaj_assets/timeline-core/scripts/, which test/corpus.test.mjs
# statically imports — a fresh clone would then fail with ERR_MODULE_NOT_FOUND
# and the corpus gate would silently never run.
/scripts/
docs/ideas/

# Spikes — local prototypes (SP1 playback engine etc.); preserved on disk, never committed
spikes/