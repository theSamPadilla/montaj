{
  "name": "blank",
  "description": "Empty editing project. Footage is optional and the edit is built by hand in the editor, following the user's instructions directly.",
  "project_type": "editing",
  "requires_clips": false,
  "steps": [
    { "id": "look_footage",   "uses": "montaj/probe",             "foreach": "clips", "note": "Look at the footage." },
    { "id": "snapshot",       "uses": "montaj/snapshot",          "foreach": "clips", "needs": ["look_footage"], "note": "Look at the footage." },
    { "id": "cut_plan",       "uses": "montaj/cut",               "needs": ["snapshot"], "note": "Only if the footage has speech. Makes a plan of what to remove; read it and adjust it if needed." },
    { "id": "cut_apply",      "uses": "montaj/cut",               "needs": ["cut_plan"], "params": { "plan": "cut-plan.md" }, "note": "Applies the plan." },
    { "id": "place",          "uses": "montaj/place",             "note": "Only if asked: lower thirds and callouts by preset, at seconds or a spoken phrase." },
    { "id": "captions_make",  "uses": "montaj/generate_captions", "note": "Only if asked." },
    { "id": "captions_style", "uses": "montaj/captions",          "needs": ["captions_make"], "note": "Only if asked." },
    { "id": "check",          "uses": "montaj/look",              "note": "Check before you finish." }
  ]
}
