{
  "description": "Arrow line",
  "category": "line",
  "props": [
    { "name": "stroke",      "type": "string", "default": "#111111", "format": "color" },
    { "name": "strokeWidth", "type": "int", "default": 8 },
    { "name": "arrowhead",   "type": "string", "default": "end", "enum": ["none", "end", "start", "both"] },
    { "name": "strokeStyle", "type": "string", "default": "solid", "enum": ["solid", "long-dash", "short-dash", "dotted"] },
    { "name": "roundCaps", "type": "bool", "default": false }
  ]
}
