{
  "description": "Border frame",
  "category": "frame",
  "props": [
    { "name": "stroke",       "type": "string", "default": "#111111", "format": "color" },
    { "name": "strokeWidth",  "type": "int", "default": 12 },
    { "name": "cornerRadius", "type": "int", "default": 0 },
    { "name": "strokeStyle", "type": "string", "default": "solid", "enum": ["solid", "long-dash", "short-dash", "dotted"] },
    { "name": "roundJoins", "type": "bool", "default": false }
  ]
}
