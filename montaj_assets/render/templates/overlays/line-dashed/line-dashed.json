{
  "description": "Dashed line",
  "category": "line",
  "props": [
    { "name": "stroke",      "type": "string", "default": "#111111", "format": "color" },
    { "name": "strokeWidth", "type": "int", "default": 8 },
    { "name": "dash",        "type": "int", "default": 24 },
    { "name": "gap",         "type": "int", "default": 16 },
    { "name": "arrowhead",   "type": "string", "default": "none", "enum": ["none", "end", "start", "both"] }
  ]
}
